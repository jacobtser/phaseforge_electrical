# ---------------------------------------------------------------------------
# PhaseForge Electrical — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Every integration is optional: the site runs without them, with graceful
# fallbacks (local JSON storage + manual "send via WhatsApp" button).
# ---------------------------------------------------------------------------

# Public site URL (used for metadata + emails)
NEXT_PUBLIC_SITE_URL=https://phaseforgeelectrical.com

# Owner WhatsApp number in full international format, no "+" or spaces
NEXT_PUBLIC_OWNER_WHATSAPP=233552813116

# Solar & EV specialist WhatsApp number (also used for Mobile Money payments)
NEXT_PUBLIC_SOLAR_WHATSAPP=233592760553
NEXT_PUBLIC_PAYMENT_WHATSAPP=233592760553

# --- Database (optional, free tier: https://neon.tech) ---------------------
# Without this, submissions are stored in a local .data/submissions.json file
# (dev only — use a real Postgres database in production).
# On Vercel, installing the Neon integration sets DATABASE_URL automatically.
# Use the pooled connection string for serverless functions.
DATABASE_URL=

# --- Paystack online payments (optional) -----------------------------------
# Secret key from Dashboard -> Settings -> API Keys & Webhooks.
# Test mode: sk_test_...   Live mode: sk_live_...
# In Paystack, set the webhook URL to: https://your-domain.com/api/paystack/webhook
# Online payments need DATABASE_URL in production (Vercel's filesystem is read-only).
PAYSTACK_SECRET_KEY=

# --- AI customer support (optional; server-side only) -----------------------
# Google AI Studio / Gemini API key. Never prefix this with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model. gemini-3.5-flash is fast and handles short/ambiguous queries well.
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the primary model is busy or unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free-tier Gemini keys have low daily request limits. For a busy shop, enable
# billing on the Google AI Studio key or use a paid-tier key.

# Optional: the owner/founder's name, shown when a customer asks who owns the
# company. Leave blank to say PhaseForge is locally owned and run by its team.
BUSINESS_OWNER_NAME=

# Learned answers from /admin/knowledge are stored in Postgres. Without
# DATABASE_URL they only persist in the local .data folder (dev only).

# --- Admin dashboard --------------------------------------------------------
ADMIN_USERNAME=admin
# Set a strong password — login stays disabled while this is empty.
ADMIN_PASSWORD=
# Required in production. A long random string that signs the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# --- Email (optional, free tier: https://resend.com) -----------------------
RESEND_API_KEY=
EMAIL_FROM=PhaseForge Electrical <notifications@phaseforgeelectrical.com>
OWNER_EMAIL=info@phaseforgeelectrical.com

# --- WhatsApp to owner ------------------------------------------------------
# Priority: meta -> callmebot -> manual wa.me button fallback
WHATSAPP_PROVIDER=callmebot
WHATSAPP_TO=233552813116

# CallMeBot (free): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Add the bot +233 55 000 1234 (or the documented number), send "I allow callmebot
# to send me messages", then paste the API key below.
CALLMEBOT_PHONE=+233552813116
CALLMEBOT_APIKEY=

# Meta WhatsApp Cloud API (optional upgrade)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Photo uploads (optional) -----------------------------------------------
# Without these, uploaded photos are stored locally in .data/uploads and served
# via /api/uploads/<file> (dev/demo only — not durable on serverless hosts).
# Set both to send photos to your own Cloudinary account instead (unsigned
# upload preset): https://cloudinary.com/documentation/upload_presets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

